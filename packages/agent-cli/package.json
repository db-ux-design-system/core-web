{
  "name": "@db-ux/agent-cli",
  "version": "5.5.0",
  "type": "module",
  "description": "CLI for DB UX Design System generate AI agent instructions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/db-ux-design-system/core-web.git"
  },
  "license": "Apache-2.0",
  "bin": {
    "agent-cli": "build/index.js"
  },
  "main": "build/index.js",
  "files": [
    "CHANGELOG.md",
    "build",
    "db-ux-consumer-powers"
  ],
  "scripts": {
    "build": "node esbuild.js",
    "copy-output": "run-p copy-output:*",
    "copy-output:build": "cpy build ../../build-outputs/agent-cli --dot",
    "copy-output:changelog": "cpy CHANGELOG.md ../../build-outputs/agent-cli/CHANGELOG.md",
    "copy-output:package.json": "cpy package.json ../../build-outputs/agent-cli/package.json",
    "copy-output:powers": "cpy db-ux-consumer-powers ../../build-outputs/agent-cli --dot",
    "copy-output:readme": "cpy README.md ../../build-outputs/agent-cli/README.md",
    "test": "vitest run --config vitest.config.ts",
    "test:cli": "tsx src/cli.ts --help",
    "test:update": "vitest run --config vitest.config.ts --update"
  },
  "dependencies": {
    "commander": "15.0.0"
  },
  "devDependencies": {
    "cpy-cli": "7.0.0",
    "esbuild": "0.28.2",
    "npm-run-all2": "9.0.3",
    "tsx": "4.23.13",
    "vitest": "5.0.1"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
