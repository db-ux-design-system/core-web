{
	"category": "colors",
	"description": "Adaptive and semantic color tokens. Colors automatically adapt based on the current color scheme (light/dark) and variant context.",
	"variants": ["neutral", "brand", "critical", "successful", "warning", "informational"],
	"groups": {
		"adaptive-bg-basic": {
			"description": "Background colors for basic surfaces at three elevation levels plus transparent variants.",
			"levels": ["level-1", "level-2", "level-3", "transparent-full", "transparent-semi"],
			"states": ["default", "hovered", "pressed"],
			"tokenPattern": "--db-adaptive-bg-basic-{level}-{state}",
			"tokens": [
				"--db-adaptive-bg-basic-level-1-default",
				"--db-adaptive-bg-basic-level-1-hovered",
				"--db-adaptive-bg-basic-level-1-pressed",
				"--db-adaptive-bg-basic-level-2-default",
				"--db-adaptive-bg-basic-level-2-hovered",
				"--db-adaptive-bg-basic-level-2-pressed",
				"--db-adaptive-bg-basic-level-3-default",
				"--db-adaptive-bg-basic-level-3-hovered",
				"--db-adaptive-bg-basic-level-3-pressed",
				"--db-adaptive-bg-basic-transparent-full-default",
				"--db-adaptive-bg-basic-transparent-full-hovered",
				"--db-adaptive-bg-basic-transparent-full-pressed",
				"--db-adaptive-bg-basic-transparent-semi-default",
				"--db-adaptive-bg-basic-transparent-semi-hovered",
				"--db-adaptive-bg-basic-transparent-semi-pressed"
			]
		},
		"adaptive-on-bg-basic": {
			"description": "Foreground/text colors on basic backgrounds with emphasis levels.",
			"emphasisLevels": ["100", "90", "80", "70", "60", "50"],
			"states": ["default", "hovered", "pressed"],
			"tokenPattern": "--db-adaptive-on-bg-basic-emphasis-{level}-{state}",
			"tokens": [
				"--db-adaptive-on-bg-basic-emphasis-100-default",
				"--db-adaptive-on-bg-basic-emphasis-100-hovered",
				"--db-adaptive-on-bg-basic-emphasis-100-pressed",
				"--db-adaptive-on-bg-basic-emphasis-90-default",
				"--db-adaptive-on-bg-basic-emphasis-90-hovered",
				"--db-adaptive-on-bg-basic-emphasis-90-pressed",
				"--db-adaptive-on-bg-basic-emphasis-80-default",
				"--db-adaptive-on-bg-basic-emphasis-80-hovered",
				"--db-adaptive-on-bg-basic-emphasis-80-pressed",
				"--db-adaptive-on-bg-basic-emphasis-70-default",
				"--db-adaptive-on-bg-basic-emphasis-70-hovered",
				"--db-adaptive-on-bg-basic-emphasis-70-pressed",
				"--db-adaptive-on-bg-basic-emphasis-60-default",
				"--db-adaptive-on-bg-basic-emphasis-50-default"
			]
		},
		"adaptive-bg-inverted": {
			"description": "Background colors for inverted (dark-on-light / light-on-dark) surfaces.",
			"levels": ["contrast-max", "contrast-high", "contrast-low"],
			"states": ["default", "hovered", "pressed"],
			"tokenPattern": "--db-adaptive-bg-inverted-{level}-{state}",
			"tokens": [
				"--db-adaptive-bg-inverted-contrast-max-default",
				"--db-adaptive-bg-inverted-contrast-max-hovered",
				"--db-adaptive-bg-inverted-contrast-max-pressed",
				"--db-adaptive-bg-inverted-contrast-high-default",
				"--db-adaptive-bg-inverted-contrast-high-hovered",
				"--db-adaptive-bg-inverted-contrast-high-pressed",
				"--db-adaptive-bg-inverted-contrast-low-default",
				"--db-adaptive-bg-inverted-contrast-low-hovered",
				"--db-adaptive-bg-inverted-contrast-low-pressed"
			]
		},
		"adaptive-on-bg-inverted": {
			"description": "Foreground/text colors on inverted backgrounds.",
			"states": ["default", "hovered", "pressed"],
			"tokens": [
				"--db-adaptive-on-bg-inverted-default",
				"--db-adaptive-on-bg-inverted-hovered",
				"--db-adaptive-on-bg-inverted-pressed"
			]
		},
		"adaptive-origin": {
			"description": "Origin colors (primary action color of the current variant).",
			"states": ["default", "hovered", "pressed"],
			"tokens": [
				"--db-adaptive-origin-default",
				"--db-adaptive-origin-hovered",
				"--db-adaptive-origin-pressed"
			]
		},
		"adaptive-on-origin": {
			"description": "Foreground/text colors on origin backgrounds.",
			"states": ["default", "hovered", "pressed"],
			"tokens": [
				"--db-adaptive-on-origin-default",
				"--db-adaptive-on-origin-hovered",
				"--db-adaptive-on-origin-pressed"
			]
		},
		"adaptive-bg-vibrant": {
			"description": "Vibrant background colors for highlighted/accent areas.",
			"states": ["default", "hovered", "pressed"],
			"tokens": [
				"--db-adaptive-bg-vibrant-default",
				"--db-adaptive-bg-vibrant-hovered",
				"--db-adaptive-bg-vibrant-pressed"
			]
		},
		"adaptive-on-bg-vibrant": {
			"description": "Foreground/text colors on vibrant backgrounds.",
			"states": ["default", "hovered", "pressed"],
			"tokens": [
				"--db-adaptive-on-bg-vibrant-default",
				"--db-adaptive-on-bg-vibrant-hovered",
				"--db-adaptive-on-bg-vibrant-pressed"
			]
		}
	},
	"semanticVariants": {
		"description": "Each semantic variant (neutral, brand, critical, successful, warning, informational) exposes the same token structure as adaptive, with the variant name replacing 'adaptive'. Example: --db-neutral-bg-basic-level-1-default, --db-brand-origin-default, --db-critical-on-bg-basic-emphasis-100-default.",
		"tokenPattern": "--db-{variant}-{group}-{level}-{state}",
		"variants": ["neutral", "brand", "critical", "successful", "warning", "informational"]
	}
}
