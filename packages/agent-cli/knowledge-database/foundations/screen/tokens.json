{
	"category": "screen",
	"description": "Breakpoint and container width tokens for responsive layout.",
	"groups": {
		"breakpoints": {
			"description": "Viewport breakpoints for responsive design.",
			"scale": ["xs", "sm", "md", "lg", "xl"],
			"tokens": [
				"--db-screen-xs",
				"--db-screen-sm",
				"--db-screen-md",
				"--db-screen-lg",
				"--db-screen-xl"
			],
			"values": {
				"--db-screen-xs": "320px (20em) — mobile",
				"--db-screen-sm": "768px (48em) — tablet",
				"--db-screen-md": "1024px (64em) — small desktop",
				"--db-screen-lg": "1440px (90em) — regular desktop",
				"--db-screen-xl": "1920px (120em) — large desktop"
			}
		},
		"container": {
			"description": "Max-width values for content containers.",
			"scale": ["3xs", "2xs", "xs", "sm", "md", "lg", "xl", "2xl", "3xl"],
			"tokens": [
				"--db-container-3xs",
				"--db-container-2xs",
				"--db-container-xs",
				"--db-container-sm",
				"--db-container-md",
				"--db-container-lg",
				"--db-container-xl",
				"--db-container-2xl",
				"--db-container-3xl"
			]
		}
	}
}
