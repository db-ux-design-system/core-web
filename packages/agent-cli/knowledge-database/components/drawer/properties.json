{
	"component": "drawer",
	"figmaProperties": [
		{
			"name": "👁️ Show Backdrop",
			"type": "BOOLEAN",
			"defaultValue": true
		},
		{
			"name": "📦 Children",
			"type": "SLOT"
		},
		{
			"name": "👁️ Show Footer",
			"type": "BOOLEAN",
			"defaultValue": false
		},
		{
			"name": "👁️ Show Spacing",
			"type": "BOOLEAN",
			"defaultValue": true
		},
		{
			"name": "🔀 Container Size",
			"type": "VARIANT",
			"values": ["(Def) Small", "Medium", "Large", "Custom", "Full"]
		},
		{
			"name": "🔀 Rounded",
			"type": "VARIANT",
			"values": ["False", "True"]
		}
	],
	"codeConnectProperties": [
		{
			"name": "⚙️ Backdrop",
			"type": "VARIANT",
			"values": ["strong"],
			"defaultValue": "strong",
			"mapsToCodeProp": "backdrop"
		},
		{
			"name": "⚙️ Direction",
			"type": "VARIANT",
			"values": ["up", "to-left", "to-right", "down"],
			"defaultValue": "down",
			"mapsToCodeProp": "direction",
			"note": "In Figma, direction is expressed via separate Component Sets (Drawer → Right, Left, Bottom, Top). Code Connect maps the active set to the direction prop."
		},
		{
			"name": "⚙️ Rounded",
			"type": "VARIANT",
			"values": ["true", "false"],
			"defaultValue": "true",
			"mapsToCodeProp": "rounded"
		},
		{
			"name": "⚙️ Size",
			"type": "VARIANT",
			"values": ["small", "medium", "large", "full", "custom"],
			"defaultValue": "small",
			"mapsToCodeProp": "containerSize"
		}
	],
	"codeProperties": [
		{
			"name": "backdrop",
			"type": "DrawerBackdropType",
			"values": ["none", "strong", "weak", "invisible"],
			"default": "strong",
			"description": "Changes the opacity of the backdrop"
		},
		{
			"name": "direction",
			"type": "DrawerDirectionType",
			"values": ["to-left", "to-right", "up", "down"],
			"description": "Position and animation direction of the drawer"
		},
		{
			"name": "open",
			"type": "boolean | string",
			"description": "Opens or closes the drawer"
		},
		{
			"name": "rounded",
			"type": "boolean | string",
			"description": "Applies border radius to the corners on the end of the drawer"
		},
		{
			"name": "containerSize",
			"type": "DrawerContainerSizeType",
			"values": ["small", "medium", "large", "full"],
			"description": "Size of the drawer container"
		},
		{
			"name": "showSpacing",
			"type": "boolean | string",
			"description": "Shows spacing between viewport frame and drawer content"
		},
		{
			"name": "variant",
			"type": "DrawerVariantType",
			"values": ["modal", "inside"],
			"default": "modal",
			"description": "Set the variant modal or inside"
		},
		{
			"name": "position",
			"type": "DrawerPositionType",
			"values": ["fixed", "absolute"],
			"default": "fixed",
			"description": "CSS position of the drawer (fixed uses showModal, absolute uses show)"
		},
		{
			"name": "header",
			"type": "any",
			"description": "Slot for the drawer header"
		},
		{
			"name": "footer",
			"type": "any",
			"description": "Slot for the drawer footer"
		}
	]
}
