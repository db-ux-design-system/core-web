		{
			"name": "behavior",
			"type": "enum",
			"values": ["static", "removable"],
			"default": "static",
			"description": "static: default without remove button; removable: adds remove button",
			"code": {
				"prop": "behavior",
				"type": "TagBehaviorType | string"
			},
			"design": {
				"name": "⚙️ Behavior",
				"codeConnect": true,
				"values": ["static", "removable"],
				"note": "In Figma, behavior is expressed via separate Component Sets (Static, Interactive, Interactive Toggle, Removable). Code Connect maps removable sets to behavior='removable'. In code, behavior only controls the remove button — interactivity is composed via child elements (checkbox, radio, link, button), not via this property."
			}
		},
		{
