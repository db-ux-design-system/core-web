{
  "component": "card",
  "figmaProperties": [
    {
      "name": "📦 Children",
      "type": "SLOT"
    },
    {
      "name": "📦 Start Slot",
      "type": "SLOT"
    },
    {
      "name": "📦 End Slot",
      "type": "SLOT"
    },
    {
