{
	"component": "custom-select-list-item",
	"figmaProperties": [
		{
			"name": "👁️ Show Divider",
			"type": "BOOLEAN",
			"defaultValue": false
		},
		{
			"name": "✏️ Group Title",
			"type": "TEXT",
			"defaultValue": "List Group Title"
		},
		{
			"name": "✏️ Label",
			"type": "TEXT",
			"defaultValue": "List Item"
		},
		{
			"name": "🔀 Interaction State",
			"type": "VARIANT",
			"values": ["(Def) Enabled", "Hovered", "Pressed", "Focused", "None"]
		},
		{
			"name": "🔀 Checked",
			"type": "VARIANT",
			"values": ["False", "True"]
		},
		{
			"name": "🔀 Disabled",
			"type": "VARIANT",
			"values": ["False", "True"]
		},
		{
			"name": "🔀 Indeterminate",
			"type": "VARIANT",
			"values": ["False", "True"]
		},
		{
			"name": "🔀 Is Group Title",
			"type": "VARIANT",
			"values": ["False", "True"]
		}
	],
	"codeConnectProperties": [
		{
			"name": "⚙️ Type",
			"type": "VARIANT",
			"values": ["checkbox", "radio"],
			"defaultValue": "checkbox",
			"mapsToCodeProp": "type"
		},
		{
			"name": "⚙️ Show Icon",
			"type": "VARIANT",
			"values": ["true", "false"],
			"defaultValue": "true",
			"mapsToCodeProp": "showIcon"
		}
	],
	"codeProperties": [
		{
			"name": "type",
			"type": "CustomSelectListItemTypeType",
			"values": ["checkbox", "radio"],
			"description": "Behavior of the item (single/radio or multiple/checkbox)"
		},
		{
			"name": "groupTitle",
			"type": "string",
			"description": "Set the title of a group of items"
		},
		{
			"name": "label",
			"type": "string",
			"description": "Label for the list item"
		},
		{
			"name": "value",
			"type": "string",
			"description": "Value of the item"
		},
		{
			"name": "checked",
			"type": "boolean | string",
			"description": "Whether the item is checked"
		},
		{
			"name": "disabled",
			"type": "boolean | string",
			"description": "Whether the item is disabled"
		},
		{
			"name": "isGroupTitle",
			"type": "boolean",
			"description": "Whether this item is a group title (text only)"
		},
		{
			"name": "showDivider",
			"type": "boolean",
			"description": "Show a divider on the bottom for visual grouping"
		},
		{
			"name": "icon",
			"type": "string",
			"description": "Leading icon name (single select only)"
		},
		{
			"name": "showIcon",
			"type": "boolean",
			"description": "Show/hide the leading icon"
		}
	]
}
