{
  "name": "@db-ux/core-vite-plugin",
  "version": "5.5.0",
  "type": "module",
  "description": "Vite plugin for optimized DB UX Design System CSS imports",
  "repository": "github:db-ux-design-system/core-web",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./index.css": "./index.css",
    "./index": "./index.css"
  },
  "files": [
    "CHANGELOG.md",
    "build",
    "index.css"
  ],
  "keywords": [
    "vite",
    "vite-plugin",
    "db-ux",
    "design-system"
  ],
  "scripts": {
    "build": "tsc",
    "copy-output": "run-p copy:*",
    "copy:changelog": "cpy CHANGELOG.md ../../build-outputs/vite-plugin/CHANGELOG.md",
    "copy:index.css": "cpy index.css ../../build-outputs/vite-plugin/index.css",
    "copy:outputs": "cpy build ../../build-outputs/vite-plugin --dot",
    "copy:package.json": "cpy package.json ../../build-outputs/vite-plugin/package.json",
    "copy:readme": "cpy README.md ../../build-outputs/vite-plugin/README.md",
    "test": "vitest run --config vitest.config.ts",
    "test:update": "npm run test -- --update"
  },
  "peerDependencies": {
    "vite": ">=4.0.0"
  },
  "dependencies": {
    "fast-glob": "^3.3.3"
  },
  "devDependencies": {
    "@db-ux/db-theme": "6.2.0",
    "@types/node": "26.6.2",
    "cpy-cli": "7.0.0",
    "npm-run-all2": "9.0.3",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "style": "index.css"
}
