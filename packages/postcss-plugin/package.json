{
  "name": "@db-ux/core-postcss-plugin",
  "version": "5.6.0",
  "type": "module",
  "description": "PostCSS plugins for DB UX Design System",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/db-ux-design-system/core-web.git"
  },
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "build"
  ],
  "keywords": [
    "postcss",
    "postcss-plugin",
    "db-ux",
    "css-variables",
    "light-dark"
  ],
  "scripts": {
    "build": "tsc",
    "copy-output": "run-p copy:*",
    "copy:changelog": "cpy CHANGELOG.md ../../build-outputs/postcss-plugin/CHANGELOG.md",
    "copy:outputs": "cpy build ../../build-outputs/postcss-plugin --dot",
    "copy:package.json": "cpy package.json ../../build-outputs/postcss-plugin/package.json",
    "copy:readme": "cpy README.md ../../build-outputs/postcss-plugin/README.md",
    "test": "vitest run --config vitest.config.ts",
    "test:update": "vitest run --config vitest.config.ts --update"
  },
  "peerDependencies": {
    "postcss": "^8.0.0"
  },
  "devDependencies": {
    "cpy-cli": "7.0.0",
    "npm-run-all2": "9.0.3",
    "postcss": "8.5.28",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
