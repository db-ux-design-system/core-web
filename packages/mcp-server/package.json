{
  "name": "@db-ux/mcp-server",
  "version": "5.4.0",
  "type": "module",
  "description": "MCP server for DB UX Design System – gives LLMs access to UI components and code examples",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/db-ux-design-system/core-web.git"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "mcp-server": "./dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "CHANGELOG.md",
    "agent",
    "assets",
    "dist"
  ],
  "scripts": {
    "build": "tsx scripts/prebuild.ts && node esbuild.js",
    "build-manifest": "tsx scripts/build-manifest.ts",
    "copy-output": "run-p copy-output:*",
    "copy-output:agent": "cpy 'agent/**' ../../build-outputs/mcp-server/agent --dot",
    "copy-output:assets": "cpy 'assets/**' ../../build-outputs/mcp-server/assets --dot",
    "copy-output:context": "cpy CONTEXT.md ../../build-outputs/mcp-server/CONTEXT.md",
    "copy-output:dist": "cpy 'dist/**' ../../build-outputs/mcp-server/dist --dot",
    "copy-output:package.json": "cpy package.json ../../build-outputs/mcp-server/package.json",
    "copy-output:readme": "cpy README.md ../../build-outputs/mcp-server/README.md",
    "dev": "pnpm run build && node dist/index.js",
    "lint": "eslint src/ --ext .ts",
    "start": "node dist/index.js",
    "test": "pnpm run build && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@db-ux/db-theme-icons": "4.2.0",
    "cpy-cli": "7.0.0",
    "esbuild": "0.28.2",
    "npm-run-all2": "9.0.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
