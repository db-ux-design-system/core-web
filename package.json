{
  "name": "@db-ux/core-web",
  "version": "0.0.0",
  "type": "module",
  "description": "DB UX Design System",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/db-ux-design-system/core-web.git"
  },
  "homepage": "https://design-system.deutschebahn.com/core-web/",
  "bugs": {
    "url": "https://github.com/db-ux-design-system/core-web/issues"
  },
  "author": "DB Systel GmbH",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "engines": {
    "node": ">= 24"
  },
  "keywords": [
    "design-system",
    "ui-library",
    "components",
    "angular",
    "react",
    "vue",
    "web-components",
    "tailwind",
    "css",
    "scss",
    "accessibility",
    "a11y",
    "responsive",
    "frontend",
    "user-interface",
    "deutsche-bahn",
    "db",
    "ux",
    "db-ux",
    "styleguide"
  ],
  "scripts": {
    "build": "pnpm --filter scripts run build",
    "build-outputs": "pnpm --filter scripts run build-outputs",
    "build-showcases": "pnpm --filter scripts run build-showcases",
    "build-storybooks": "pnpm --filter scripts run build-storybooks",
    "changeset": "changeset",
    "check:format": "prettier --check .",
    "ci:version": "changeset version && pnpm tsx scripts/github/changesets/version-bump.ts && prettier --no-error-on-unmatched-pattern **/CHANGELOG.md --write",
    "clean": "git clean -dfx --exclude=.env",
    "clean:light": "git clean -dfx --exclude=.env --exclude=node_modules",
    "codestyle": "prettier . --write",
    "commit:updated-snapshots": "git diff --name-only --diff-filter=M | xargs git add && git commit --message 'test: updated snapshots'",
    "dev": "pnpm --filter scripts run dev",
    "generate:agent": "pnpm --filter scripts run agent",
    "generate:component": "pnpm --filter @db-ux/core-components run generate:component",
    "lint": "run-p lint:*",
    "lint-docs-file-references": "node scripts/check-docs.js",
    "lint-packages": "pnpm tsx scripts/lint-packages.ts publint",
    "lint:codespell": "cspell . .changeset --config .config/cspell.config.ts --quiet",
    "lint:jscpd": "jscpd . --exit-code 1 --config .config/.jscpd.json",
    "lint:knip": "knip --config .config/knip.jsonc",
    "lint:markdownlint": "markdownlint --config .config/.markdown-lint.yml **/*.md",
    "lint:package-json": "npmPkgJsonLint ./packages ./output --configFile .config/.npmpackagejsonlintrc.json",
    "lint:storybook-config": "node storybooks/_shared/storybook-config/sync.ts --check",
    "lint:storybook-foundations": "node storybooks/_shared/foundations/generate-foundations.ts --check",
    "lint:stylelint": "stylelint **/*.{css,scss}",
    "lint:xo": "xo",
    "prepare": "husky",
    "regenerate:screenshots": "pnpm run build && pnpm --filter react-showcase run build && pnpm --filter react-showcase run regenerate:visual-snapshots && pnpm --filter react-showcase run regenerate:aria-snapshots",
    "release:publish": "node scripts/github/publish-npm.js",
    "rm:builds": "pnpm --filter scripts run rm:builds",
    "start": "pnpm --filter patternhub run start",
    "test": "pnpm --filter scripts run test",
    "test:react-core-components": "pnpm --filter react-showcase run test:interaction",
    "test:storybooks": "playwright test -c storybooks/_shared/tests/playwright.config.ts",
    "test:vue-components": "pnpm --filter vue-showcase run test:interaction",
    "update:dependency:playwright": "node scripts/github/update-playwright.js",
    "validate": "tsx scripts/self-healing-orchestrator.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@changesets/cli": "3.0.3",
    "@changesets/types": "7.0.0",
    "@commitlint/cli": "21.2.4",
    "@db-ux/core-components": "workspace:*",
    "@db-ux/core-eslint-plugin": "workspace:*",
    "@db-ux/core-foundations": "workspace:*",
    "@db-ux/core-stylelint": "workspace:*",
    "@db-ux/db-theme": "7.2.0",
    "@db-ux/db-theme-fonts": "2.2.0",
    "@db-ux/db-theme-icons": "4.4.0",
    "@double-great/stylelint-a11y": "3.8.3",
    "@figma/code-connect": "2.1.0",
    "@guidepup/guidepup": "0.40.0",
    "@guidepup/playwright": "0.21.0",
    "@guidepup/record": "0.3.0",
    "@guidepup/setup": "0.29.3",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@typescript-eslint/eslint-plugin": "8.72.2",
    "@typescript-eslint/parser": "8.72.2",
    "accessibility-checker-engine": "4.0.34",
    "cspell": "10.4.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-config-xo": "7.0.0",
    "eslint-plugin-package-json": "1.14.0",
    "http-server": "14.1.1",
    "husky": "9.1.7",
    "jscpd": "5.4.3",
    "knip": "6.44.2",
    "lint-staged": "17.6.0",
    "markdownlint-cli": "0.50.0",
    "npm-package-json-lint": "11.0.1",
    "npm-run-all2": "9.0.4",
    "playwright": "1.65.0",
    "playwright-core": "1.65.0",
    "prettier": "3.9.10",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-pkg": "0.22.1",
    "stylelint": "18.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-use-logical": "2.1.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "validate-branch-name": "1.3.2",
    "xo": "5.0.1"
  },
  "validate-branch-name": {
    "pattern": "^((dependabot|renovate)-[a-zA-Z0-9_.-]+|(test|feat|fix|chore|docs|refactor|style|ci|perf|alert|[0-9]+)-[a-zA-Z0-9-]+)$",
    "errorMsg": "There is something wrong with your branch name. You should rename your branch to a valid name and try again. See the Pattern below."
  }
}
