{
  "name": "composition-storybook",
  "version": "0.0.0",
  "type": "module",
  "description": "Composition storybook",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/db-ux-design-system/core-web.git"
  },
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "build": "node ../_shared/storybook-config/copy-config.ts --storybook _storybook && node ../_shared/foundations/generate-test-table.ts && storybook build --output-dir ../../build-storybooks/composition-storybook",
    "storybook": "node ../_shared/storybook-config/copy-config.ts --storybook _storybook && node ../_shared/foundations/generate-test-table.ts && storybook dev -p 6001"
  },
  "dependencies": {
    "@db-ux/core-components": "workspace:*",
    "@db-ux/db-theme": "7.2.0",
    "@db-ux/db-theme-fonts": "2.2.0",
    "@db-ux/db-theme-icons": "4.4.0",
    "@db-ux/react-core-components": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-storybook": "10.6.7",
    "globals": "17.14.0",
    "storybook": "10.6.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "8.3.7"
  }
}
