{
  "name": "react-storybook",
  "version": "0.0.0",
  "type": "module",
  "description": "React storybook",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/db-ux-design-system/core-web.git"
  },
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "build": "node ../_shared/storybook-config/copy-config.ts --storybook react-storybook && node ../_shared/overview/generate-overviews.ts --storybook react-storybook && storybook build --output-dir ../../build-storybooks/react-storybook",
    "storybook": "node ../_shared/storybook-config/copy-config.ts --storybook react-storybook && node ../_shared/overview/generate-overviews.ts --storybook react-storybook && storybook dev -p 6005"
  },
  "dependencies": {
    "@db-ux/core-components": "workspace:*",
    "@db-ux/db-theme": "7.2.0",
    "@db-ux/db-theme-fonts": "2.2.0",
    "@db-ux/db-theme-icons": "4.4.0",
    "@db-ux/react-core-components": "workspace:*",
    "@faker-js/faker": "10.6.0",
    "@tanstack/match-sorter-utils": "9.2.6",
    "@tanstack/react-table": "9.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/react-vite": "10.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-storybook": "10.6.6",
    "globals": "17.14.0",
    "storybook": "10.6.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "8.3.7"
  }
}
