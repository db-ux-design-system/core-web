{
  "name": "@db-ux/v-core-components",
  "version": "5.6.2",
  "type": "module",
  "description": "Vue components for @db-ux/core-components",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/db-ux-design-system/core-web.git"
  },
  "license": "Apache-2.0",
  "main": "./dist/db-ux.umd.js",
  "module": "./dist/db-ux.es.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/db-ux.es.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/db-ux.umd.js"
      }
    }
  },
  "files": [
    "CHANGELOG.md",
    "agent",
    "dist/"
  ],
  "scripts": {
    "build": "npm-run-all --parallel build:* --parallel mv:*",
    "build:01_vite": "vite build",
    "build:02_types": "vue-tsc --declaration --emitDeclarationOnly",
    "mv:agent": "cpy agent ../../build-outputs/vue --dot",
    "mv:changelog": "cpy CHANGELOG.md ../../build-outputs/vue/CHANGELOG.md",
    "mv:dist": "cpy dist ../../build-outputs/vue --dot",
    "mv:package.json": "cpy package.json ../../build-outputs/vue/package.json",
    "mv:readme": "cpy README.md ../../build-outputs/vue/README.md"
  },
  "dependencies": {
    "@db-ux/core-components": "workspace:*",
    "@db-ux/core-foundations": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/compiler-dom": "3.5.43",
    "cpy-cli": "7.0.0",
    "npm-run-all2": "9.0.3",
    "replace-in-file": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vue": "3.5.43",
    "vue-tsc": "3.3.12"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "sideEffects": false,
  "source": "src/index.ts"
}
