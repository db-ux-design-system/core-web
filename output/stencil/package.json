{
  "name": "@db-ux/wc-core-components",
  "version": "5.4.0",
  "type": "module",
  "description": "Stencil components for @db-ux/core-components",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/db-ux-design-system/core-web.git"
  },
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/loader/index.d.ts",
      "import": "./dist/loader/index.js"
    },
    "./bundle": {
      "types": "./bundle/index.d.ts",
      "import": "./bundle/index.js"
    },
    "./bundle/*.js": {
      "types": "./bundle/*.d.ts",
      "import": "./bundle/*.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "agent",
    "bundle/",
    "dist/"
  ],
  "scripts": {
    "build": "npm-run-all build:* --parallel mv:*",
    "build:_stencil": "stencil build",
    "build:cem": "cem analyze",
    "dev-build": "stencil build --config stencil.config.dev.ts",
    "mv:agent": "cpy agent ../../build-outputs/wc-core-components --dot",
    "mv:bundle": "cpy bundle ../../build-outputs/wc-core-components --dot",
    "mv:changelog": "cpy CHANGELOG.md ../../build-outputs/wc-core-components/CHANGELOG.md",
    "mv:dist": "cpy dist ../../build-outputs/wc-core-components --dot",
    "mv:package.json": "cpy package.json ../../build-outputs/wc-core-components/package.json",
    "mv:readme": "cpy README.md ../../build-outputs/wc-core-components/README.md",
    "start": "stencil build --watch --config stencil.config.dev.ts"
  },
  "dependencies": {
    "@db-ux/core-components": "workspace:*",
    "@db-ux/core-foundations": "workspace:*"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "0.11.0",
    "@stencil/core": "4.45.0",
    "@types/node": "26.5.1",
    "cem-plugin-expanded-types": "1.4.0",
    "cpy-cli": "7.0.0",
    "custom-element-jet-brains-integration": "1.8.0",
    "custom-element-vs-code-integration": "1.5.0",
    "npm-run-all2": "9.0.3",
    "storybook": "10.6.0",
    "workbox-build": "7.4.1"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "customElements": "dist/custom-elements.json",
  "web-types": "./dist/web-types.json"
}
